# OpenRouter API key for querying AI platforms (ChatGPT, Claude, Perplexity via OpenRouter)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# AI model to use for analysis (analyzing brand mentions in AI responses)
# Default: openai/gpt-4o-mini
ANALYSIS_MODEL=openai/gpt-4o-mini

# Path to SQLite database file (stores query results and analysis)
# Default: ./brand_monitor.db
BRAND_MONITOR_DB=./brand_monitor.db

# Path to output directory (for reports and exports)
# Default: ./output
BRAND_MONITOR_OUTPUT=./output
